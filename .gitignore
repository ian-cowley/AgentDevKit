## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Re]leasePublic/
x64/
x86/
build/
bin/
obj/
packages/
TestResults/

# Visual Studio cache files
.vs/

# Secrets & local configuration (Zero Secrets Policy)
appsettings.json
appsettings.*.json
!appsettings.template.json
.env
*.env
*.env.*
!*.env.example

# SQL Server & SQLite files
*.mdf
*.ldf
*.ndf
*.db
*.db-shm
*.db-wal

# Log & session files
*.log
telemetry.log
agent_sessions/
agent_sessions.db

# Others
/test/
/docs/images/*.png
/docs/images/*.jpg
/docs/images/*.jpeg
/docs/images/*.gif
